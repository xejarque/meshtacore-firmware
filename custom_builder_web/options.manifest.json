      "section": "meshtastic",
      "type": "bitmask",
      "key": "USERPREFS_NEXUS_PPING_CHANNELS",
      "label": "Canales donde responde el bot",
      "cmd": "/mt PPING CHAN",
      "labelsFromChannels": true,
      "channelSplit": {
        "prefix": "MC:",
        "plain": {
          "section": "meshtastic",
          "label": "Canales de Meshtastic donde responde el bot",
          "cmd": "/mt PPING CHAN"
        },
        "prefixed": {
          "section": "meshcore",
          "label": "Canales de MeshCore donde responde el bot",
          "cmd": "/mc PPING CHAN",
          "switchLabel": "Bot PPING de MeshCore activo",
          "switchCmd": "/mc PPING ON",
          "switchChannel": "MC:#bot"
        }
      },
      "always": true,
      "default": 132,
      "width": 8,
      "format": "dec",
      "bits": [
        {
          "bit": 0,
          "id": "ch0",
          "label": "Canal 0"
