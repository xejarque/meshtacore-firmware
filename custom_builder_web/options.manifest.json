{
  "version": 1,
  "note": "Fuente única de las opciones Nexus del builder. La leen app.js y generate_custom_userprefs.py. Una opción con su valor por defecto (o vacía) no se emite.",
  "groups": [
    {
      "id": "bots",
      "title": "Bots (PPING)",
      "description": "Bot de ping público de Meshtastic (/mt PPING) y de MeshCore (/mc PPING). Valores iniciales: solo se aplican en el primer arranque o tras un factory reset; un vault guardado (/mtc SAVE) manda siempre.",
      "sections": [
        { "id": "meshtastic", "title": "Meshtastic" },
        { "id": "meshcore", "title": "MeshCore" },
        { "id": "shared", "title": "Compartido (Meshtastic y MeshCore)" }
      ]
    },
    {
      "id": "firewall",
      "title": "Firewall",
      "description": "Filtros de entrada y salida, límites por hora y retardo de respuestas (/mtc DROP, OUTDROP, INVALID, RATELIMIT, BD)."
    },
    {
      "id": "system",
      "title": "Zero-Hop, features y seguridad",
      "description": "Zero-Hop (/mtc ZH), features (/mtc FEATURES) y seguridad de comandos (/mtc SECURITY)."
    },
    {
      "id": "meshcore",
      "title": "MeshCore avanzado",
      "description": "Ruta y profundidad de inundación de MeshCore (/mc). Solo valen mientras no exista /prefs/meshcore_config.bin."
    },
    {
      "id": "radio",
      "title": "Radio y claves",
      "description": "Preámbulo y claves maestras adicionales."
    },
    {
      "id": "device",
      "title": "Dispositivo",
      "description": "Opciones con control propio en builder.html."
    }
  ],
  "options": [
    {
      "id": "pping_enabled",
      "group": "bots",
      "section": "meshtastic",
      "type": "bool",
      "key": "USERPREFS_NEXUS_PPING_ENABLED",
      "label": "Bot PPING de Meshtastic activo",
      "cmd": "/mt PPING ON",
      "default": false
    },
    {
      "id": "pping_channels",
